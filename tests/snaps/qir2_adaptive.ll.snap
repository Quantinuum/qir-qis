  tail call void @___rxy(i64 %qalloc.i, double 0x3FF921FB54442D18, double 0xBFF921FB54442D18)
  %qbit.i4.i = load i64, ptr @qis_qs.0, align 8
  tail call void @___rz(i64 %qbit.i4.i, double 0x400921FB54442D18)
  %qbit = load i64, ptr @qis_qs.0, align 8
  %meas = tail call i64 @___lazy_measure(i64 %qbit)
  %state1.i.i = load i8, ptr @qir_qis.static_results, align 8
  %is_pending.i.i = icmp eq i8 %state1.i.i, 1
  br i1 %is_pending.i.i, label %dec_future.i.i, label %qir_qis.static_result_read.exit

dec_future.i.i:                                   ; preds = %qir_qis.init_qubit.exit
  %future2.i.i = load i64, ptr getelementptr inbounds nuw (i8, ptr @qir_qis.static_results, i64 8), align 8
  tail call void @___dec_future_refcount(i64 %future2.i.i)
  br label %qir_qis.static_result_read.exit

qir_qis.static_result_read.exit:                  ; preds = %dec_future.i.i, %qir_qis.init_qubit.exit
  store i1 false, ptr getelementptr inbounds nuw (i8, ptr @qir_qis.static_results, i64 1), align 1
  store i8 1, ptr @qir_qis.static_results, align 8
  store i64 %meas, ptr getelementptr inbounds nuw (i8, ptr @qir_qis.static_results, i64 8), align 8
  %bool.i.i = tail call i1 @___read_future_bool(i64 %meas)
  tail call void @___dec_future_refcount(i64 %meas)
  store i1 %bool.i.i, ptr getelementptr inbounds nuw (i8, ptr @qir_qis.static_results, i64 1), align 1
  store i8 2, ptr @qir_qis.static_results, align 8
  br i1 %bool.i.i, label %cont, label %qir_qis.static_result_read.exit11

cont:                                             ; preds = %qir_qis.static_result_read.exit
  %qbit.i.i3 = load i64, ptr @qis_qs.0, align 8
  tail call void @___rz(i64 %qbit.i.i3, double 0x400921FB54442D18)
  %state2.i.i4.pr = load i8, ptr @qir_qis.static_results, align 8
  switch i8 %state2.i.i4.pr, label %qir_qis.static_result_read.exit11 [
    i8 1, label %pending.i.i8
    i8 2, label %cont.cached.i.i5_crit_edge
  ]

cont.cached.i.i5_crit_edge:                       ; preds = %cont
  %cached4.i.i6.pre = load i1, ptr getelementptr inbounds nuw (i8, ptr @qir_qis.static_results, i64 1), align 1
  br label %qir_qis.static_result_read.exit11

pending.i.i8:                                     ; preds = %cont
  %future3.i.i9 = load i64, ptr getelementptr inbounds nuw (i8, ptr @qir_qis.static_results, i64 8), align 8
  %bool.i.i10 = tail call i1 @___read_future_bool(i64 %future3.i.i9)
  tail call void @___dec_future_refcount(i64 %future3.i.i9)
  store i1 %bool.i.i10, ptr getelementptr inbounds nuw (i8, ptr @qir_qis.static_results, i64 1), align 1
  store i8 2, ptr @qir_qis.static_results, align 8
  br label %qir_qis.static_result_read.exit11

qir_qis.static_result_read.exit11:                ; preds = %pending.i.i8, %cont.cached.i.i5_crit_edge, %cont, %qir_qis.static_result_read.exit
  %common.ret.op.i.i7 = phi i1 [ %bool.i.i10, %pending.i.i8 ], [ false, %cont ], [ %cached4.i.i6.pre, %cont.cached.i.i5_crit_edge ], [ false, %qir_qis.static_result_read.exit ]
  tail call void @print_bool(ptr nonnull @res_r0, i64 14, i1 %common.ret.op.i.i7)
  %state1.i.i12 = load i8, ptr @qir_qis.static_results, align 8
  %is_pending.i.i13 = icmp eq i8 %state1.i.i12, 1
  br i1 %is_pending.i.i13, label %dec_future.i.i14, label %qir_qis.clear_static_results.exit

dec_future.i.i14:                                 ; preds = %qir_qis.static_result_read.exit11
  %future2.i.i15 = load i64, ptr getelementptr inbounds nuw (i8, ptr @qir_qis.static_results, i64 8), align 8
  tail call void @___dec_future_refcount(i64 %future2.i.i15)
